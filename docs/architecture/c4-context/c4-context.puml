@startuml КонтекстC4
!include <C4/C4_Context>

title C4, уровень 1 — Контекст: «Учебное расписание и конфликтология»

Person(uo, "Учебный отдел", "Загружает расписание, исправляет конфликты, отправляет расписание на согласование", $type="Пользователь")
Person(adm, "Администратор расписания", "Согласует или отклоняет расписание с комментарием, управляет учётными записями", $type="Пользователь")
Person(guest, "Посетитель сайта", "Студенты, преподаватели и все остальные. Смотрит опубликованное расписание без входа", $type="Пользователь")

System(sys, "Учебное расписание и конфликтология", "Хранит учебное расписание, находит конфликты по аудитории, преподавателю, группе и вместимости, строит отчёт и журнал проверок, проводит согласование и публикует расписание на сайте", $type="Программная система")

Rel(uo, sys, "Загружает расписание (CSV), правит занятия, запускает проверку, выгружает отчёт (CSV), отправляет на согласование")
Rel(adm, sys, "Согласует или отклоняет расписание с комментарием, создаёт учётные записи, смотрит отчёт и журнал проверок")
Rel(guest, sys, "Смотрит опубликованное расписание с фильтрами по преподавателю, группе, аудитории")

note right of sys
  Внешних систем нет:
  интеграций нет (ограничение кейса),
  обмен данными — через CSV.
end note

@enduml
