@startuml
!include <C4/C4_Container>

title Учебное расписание и конфликтология — C4 Container Diagram (MVP)

Person(office, "Учебный отдел", "Готовит и проверяет расписание")
Person(admin, "Администратор расписания", "Рассматривает расписание и принимает решение")
Person(visitor, "Посетитель сайта", "Смотрит опубликованное расписание без входа")

System_Boundary(schedule, "Учебное расписание и конфликтология") {
    Container(onec, "Приложение 1С", "1С:Предприятие 8.3.27", "Хранит рабочие данные, поддерживает подготовку, проверку и согласование расписания, формирует отчёты и отправляет публикацию")
    Container(frontend, "Публичный фронтенд", "HTML, CSS, JavaScript", "Показывает расписание в браузере, позволяет выбрать неделю и фильтры")
    Container(backend, "Бэкенд", "Python, FastAPI", "Проверяет и принимает публикации, предоставляет API просмотра и фильтрации")
    ContainerDb(db, "Хранилище опубликованного расписания", "PostgreSQL", "Хранит последнюю успешно принятую публикацию, её занятия и связанные справочные данные")
}

Rel_D(office, onec, "Готовит расписание, проверяет конфликты и передаёт на согласование", "Веб-клиент 1С, HTTPS")
Rel_D(admin, onec, "Согласовывает или отклоняет расписание, смотрит отчёт и журнал", "Веб-клиент 1С, HTTPS")
Rel_D(visitor, frontend, "Смотрит расписание, выбирает неделю и фильтры", "Интерфейс в браузере")
Rel_D(frontend, backend, "Запрашивает опубликованные занятия и значения фильтров", "HTTPS, JSON API")
Rel_D(onec, backend, "Отправляет полный снимок согласованного расписания для публикации", "HTTPS, JSON API, служебный ключ")
Rel_D(backend, db, "Сохраняет публикацию и читает опубликованную копию", "SQL, протокол PostgreSQL")

SHOW_LEGEND()
@enduml