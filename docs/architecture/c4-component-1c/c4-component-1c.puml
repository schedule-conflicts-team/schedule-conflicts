@startuml
!include <C4/C4_Component>

title Приложение 1С — C4 Component Diagram (проект MVP)

Container_Boundary(onec, "Приложение 1С") {
    rectangle "Формы и календарь\n[Интерфейс 1С]" as forms
    rectangle "Форма загрузки\n[Интерфейс 1С]" as upload

    Component(schedule, "Управление расписанием", "Серверная логика 1С", "Создаёт черновики, сохраняет занятия и ведёт согласование")
    Component(importCsv, "Импорт", "Серверная логика 1С", "Читает CSV и подготавливает занятия и справочные данные")
    Component(validation, "Проверка данных расписания", "Серверная логика 1С", "Проверяет данные при ручном вводе и импорте, возвращает ошибки")
    Component(conflicts, "Поиск конфликтов", "Серверная логика 1С", "Проверяет всё расписание на пересечения и превышение вместимости")
    Component(reporting, "Отчётность", "Серверная логика 1С", "Показывает, фильтрует и выгружает сохранённые результаты")
    Component(publishing, "Публикация", "Серверная логика 1С", "Готовит и сохраняет снимок отправки, учитывает результат доставки и повторные попытки")

    database "Регистры проверок\n[Информационная база 1С]" as checks
}

Container(backend, "Бэкенд", "Python, FastAPI", "Принимает публикацию расписания")

Rel(forms, schedule, "Вызывает операции подготовки и согласования")
Rel(upload, importCsv, "Передаёт CSV для загрузки")
Rel(importCsv, validation, "Проверяет данные из CSV")
Rel(importCsv, schedule, "Передаёт подготовленные занятия для сохранения")
Rel(schedule, validation, "Проверяет данные при ручном вводе и перед согласованием")
Rel(schedule, conflicts, "Запускает поиск по команде или перед согласованием")
Rel(schedule, publishing, "Передаёт согласованный снимок при одобрении")
Rel(conflicts, checks, "Сохраняет результаты и историю запусков")
Rel(forms, checks, "Календарь читает сохранённые результаты")
Rel(reporting, checks, "Читает сохранённые результаты для отчёта")
Rel(publishing, backend, "Отправляет полный снимок для публикации", "HTTPS, JSON API, служебный ключ")
@enduml